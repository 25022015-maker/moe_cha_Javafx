<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="700.0" prefWidth="900.0" style="-fx-background-color: #f4f6f9;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.controller.AuctionRoomController">
    <children>
      <VBox alignment="CENTER" prefHeight="680.0" prefWidth="880.0" spacing="10.0" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">
         <children>
            <HBox prefHeight="375.0" prefWidth="880.0" VBox.vgrow="ALWAYS">
               <children>
      
                      <VBox prefWidth="700.0" spacing="15.0" HBox.hgrow="ALWAYS">
                          <children>
                              <VBox style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15;">
                                  <children>
                                      <Label fx:id="lblTitle" text="Bất động sản biệt thự Vinhomes(lblTitle)" textFill="#2c3e50">
                                          <font>
                                              <Font name="System Bold" size="22.0" />
                                          </font>
                                      </Label>
                                      <Label fx:id="lblTimeRemaining" text="⏳ Thời gian còn lại: 00:14:55(lblTimeRemaining)" textFill="#e74c3c">
                                          <font>
                                              <Font name="System Bold" size="14.0" />
                                          </font>
                                      </Label>
                                  </children>
                              </VBox>
                        <HBox prefHeight="300.0" prefWidth="850.0" spacing="20.0">
                           <children>
            
                                    <VBox style="-fx-background-color: white; -fx-background-radius: 10;" HBox.hgrow="ALWAYS">
                                        <children>
                                            <Label text="📈 Biểu đồ biến động giá trực tuyến" textFill="#34495e">
                                                <font>
                                                    <Font name="System Bold" size="14.0" />
                                                </font>
                                                <VBox.margin>
                                                    <Insets left="15.0" top="15.0" />
                                                </VBox.margin>
                                            </Label>
                                            <LineChart fx:id="priceChart" createSymbols="true" prefHeight="236.0" prefWidth="523.0">
                                                <xAxis>
                                                    <CategoryAxis label="Thời gian" side="BOTTOM" />
                                                </xAxis>
                                                <yAxis>
                                                    <NumberAxis label="Giá (kVND)" side="LEFT" />
                                                </yAxis>
                                            </LineChart>
                                        </children>
                                    </VBox>
            
                                          <VBox prefHeight="185.0" prefWidth="399.0" spacing="8.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15;" HBox.hgrow="ALWAYS">
                                        <children>
                                            <Label text="🔔 Nhật ký phiên đấu giá" textFill="#2c3e50">
                                                <font>
                                                    <Font name="System Bold" size="14.0" />
                                                </font>
                                            </Label>
                                            <TextArea fx:id="txtAreaLog" editable="false" prefHeight="200.0" prefWidth="250.0" style="-fx-text-fill: #2c3e50; -fx-font-family: monospace;" text="[Hệ thống] Phiên đấu giá bắt đầu.&#10;" wrapText="true" VBox.vgrow="ALWAYS" />
                                        </children>
                                    </VBox>
                           </children>
                        </HBox>
                          </children>
                      </VBox>
               </children>
            </HBox>
         </children>
      </VBox>
    </children>
</AnchorPane>
